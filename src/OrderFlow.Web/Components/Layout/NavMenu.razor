@inject JwtAuthenticationStateProvider Auth
@inject NavigationManager Navigation

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="">
            <BrandMark />
            <span>OrderFlow</span>
        </a>

        <nav class="topbar-nav" aria-label="Navegação principal">
            <NavLink class="topbar-link" href="" Match="NavLinkMatch.All">Início</NavLink>
            <AuthorizeView>
                <Authorized>
                    <NavLink class="topbar-link" href="produtos">Produtos</NavLink>
                    <NavLink class="topbar-link" href="perfil">Meu perfil</NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="topbar-actions">
            <AuthorizeView>
                <Authorized>
                    <span class="user-chip" title="@context.User.Identity?.Name">
                        <span class="user-chip-avatar" aria-hidden="true">@Initial(context.User.Identity?.Name)</span>
                        <span class="user-chip-email">@context.User.Identity?.Name</span>
                    </span>
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="SignOutAsync">Sair</button>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-ghost btn-sm" href="login">Entrar</a>
                    <a class="btn btn-brand btn-sm" href="register">Criar conta</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    private async Task SignOutAsync()
    {
        await Auth.SignOutAsync();

        // Recarrega a página inicial para começar do zero, sem sobras da sessão encerrada.
        Navigation.NavigateTo("", forceLoad: true);
    }

    private static string Initial(string? name) =>
        string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();
}
