@page "/Error"
@using System.Diagnostics

<PageTitle>Erro · OrderFlow</PageTitle>

<section class="empty-state">
    <h1 class="page-title">Algo deu errado</h1>
    <p class="page-subtitle">Ocorreu um erro ao processar a sua solicitação.</p>

    @if (ShowRequestId)
    {
        <p>
            Código da requisição: <code>@RequestId</code>
        </p>
    }

    <a class="btn btn-brand" href="">Voltar ao início</a>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
