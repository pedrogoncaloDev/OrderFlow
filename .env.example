# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
# O .env NÃO deve ser commitado (já está no .gitignore).

# PostgreSQL
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# JWT (API) — chave de assinatura dos tokens, com no mínimo 32 caracteres.
# Em Development, se ficar vazia, a API gera uma chave temporária a cada execução (as sessões caem ao reiniciar).
# Em produção é obrigatória. Para gerar uma: openssl rand -base64 48
Jwt__Key=
